{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/web/**/*.d.ts",
    "src/browser-map-flow/**/*.ts",
    "src/leaflet/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
