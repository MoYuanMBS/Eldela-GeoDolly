{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/browser/**/*.ts",
    "src/browser/**/*.tsx",
    "src/browser/**/*.d.ts",
    "src/shared/**/*.ts",
    "src/models/common/**/*.ts",
    "src/models/mapsurface/**/*.ts",
    "src/models/measure-tools/**/*.ts",
    "src/models/web/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
