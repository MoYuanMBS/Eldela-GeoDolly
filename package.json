{
  "name": "geomcp",
  "version": "0.1.0",
  "private": true,
  "description": "GeoMCP project scaffold. Authority source: doc/GeoMCP 技术规范文档.md",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:web": "node --import tsx test/web/dev-map-service.ts",
    "dev:warning-http": "node --import tsx src/http/browser-warning-service-main.ts",
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "start": "node dist/index.js",
    "start:warning-http": "node dist/http/browser-warning-service-main.js",
    "test:local": "bash local_test/run_local_tests.sh",
    "test:py-local": ".venv/bin/python -m unittest discover -s local_test/py -p \"test_*.py\"",
    "test:ts-local": "node --import tsx --test local_test/ts/**/*.test.ts local_test/src/**/*.test.ts",
    "typecheck:ts-local": "tsc -p local_test/ts/tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:web-test": "tsc -p test/web/tsconfig.json --noEmit",
    "lint:py": ".venv/bin/python -m pylint python",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "canvas": "^3.1.2",
    "geographiclib-geodesic": "^2.2.0",
    "jsdom": "^26.1.0",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.33.0",
    "playwright": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^8.2.0"
  }
}
