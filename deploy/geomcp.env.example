# 复制为 deploy/geomcp.env 并修改部署值；实际 *.env 文件不提交。
# JSON 数字、布尔和列表使用其原生类型；只覆盖提供的字段，其他字段读取 YAML。
# JSON 字符串中的 # 写成 \u0023，兼容 Node 与 Docker 的环境文件解析。
# Node: node --env-file=deploy/geomcp.env --import tsx src/index.ts
# Docker: docker run --env-file deploy/geomcp.env <image>
# App 构建和后端启动必须使用同一份环境；当前 App 不支持运行时替换构建内的公开地址。
# 本机 HTTP + 外部 HTTPS 适用于隧道或反向代理，不绑定服务商。
GEOMCP_WEB_CONFIG_JSON={"http":{"listen_host":"0.0.0.0","listen_protocol":"http","map":{"port":23336,"public_origin":"https://maps.example.com"}}}
GEOMCP_APP_CONFIG_JSON={"overpass":{"endpoint":"https://overpass.openstreetmap.fr/api/interpreter","overlay_skel_concurrency":1,"endpoints":[]},"geometry":{"tool_a_bbox_expand_km":0.75,"tool_b_bbox_expand_km":0.75},"iframe_adaptive":{"min_screenshot_width":600,"max_screenshot_width":5000,"min_screenshot_height":600,"max_screenshot_height":5000,"reference_screenshot_area":400000,"min_aspect_ratio":0.8,"max_aspect_ratio":3.2},"ui":{"iframe_max_width_px":1600,"iframe_max_height_px":1000}}
